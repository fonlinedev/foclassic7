[engl]
{100}{}{Razlo}
{200}{}{You see Razlo.}
{1000}{}{[AUTO-GENERATED SKELETON: replace this entry with the NPC's initial greeting and
conditions.]}
{1010}{}{Its late.}
{1020}{}{Its day.}
{1030}{}{It's day again.}
{2000}{}{It's late. Come back in the morning.}
{2010}{}{But I need your help.}
{2020}{}{I'm trying to kill some radscorpions. Do you have anything to help?}
{2030}{}{I'm looking for Tandi. Can you help?}
{2040}{}{Hnn.}
{3000}{}{Are you hurt?}
{3010}{}{Yes.}
{3020}{}{No.}
{4000}{}{Great Brahmin! Why didn't you say so?}
{4010}{}{Uhhh. I did . . .}
{5000}{}{[MANUAL: add NPC dialogue for diagram node 'razlo05n']}
{5010}{}{[MANUAL: add player response/transition -> razlofixa]}
{5020}{}{[MANUAL: add player response/transition -> razlofixb]}
