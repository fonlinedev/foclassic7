#include "npc_roles_h.fos"


#define SP_OPENED             (0)
#define SP_CLOSED             (1)

#define SP_LOCK_COMPLEXITY    (120)

#define SP_OPEN_HOUR          (17)
#define SP_CLOSE_HOUR         (4)

void SetBarState(uint mode, Map@ map)
{
    if(map is null)
        return;

    map.SetData(MAP_DATA_SKUMPITT, mode);
}

// Check current time and immediately synchronize the bar.
void UpdateSkumpittState()
{
    Map@ map = GetMapByPid(MAP_JunktownNorth, 0);

    if(map is null)
        return;

    uint16 year = 0, month = 0, day = 0, dayofweek = 0;
    uint16 hour = 0, minute = 0, second = 0;

    GetGameTime(__FullSecond, year, month, day, dayofweek, hour, minute, second);

    array<uint> values;

    if(hour >= SP_OPEN_HOUR || hour < SP_CLOSE_HOUR)
    {
        Log("Skumpitt: Bar is OPEN. Time: " + hour + " : " + minute);
        e_OpenSkumpitt(values);
    }
    else
    {
        Log("Skumpitt: Bar is CLOSED. Time: " + hour + " : " + minute);
        e_CloseSkumpitt(values);
    }
}

void InitSkumpittEvents()
{
    Log("Creating Skumpitt events");

    // Synchronize immediately with the current in-game time.
    UpdateSkumpittState();

    // Schedule daily opening and closing.
    CreateTimeEvent(GetNearFullSecond(0, 0, 0, 4, 0, 0), "e_CloseSkumpitt", false);   

    CreateTimeEvent(GetNearFullSecond(0, 0, 0, 17, 15, 0), "e_OpenSkumpitt", false);

}

// Remove all npcs, move Neal to the room.
uint e_CloseSkumpitt(array<uint>@ values)
{
    Map@ map = GetMapByPid(MAP_JunktownNorth, 0);

    if(!valid(map)) {
        Log("Invalid map " + MAP_JunktownNorth);
        return 0;
    }
    
    Log("It's morning, Skumpitt is closing.");

    RemoveSkumpittPatrons();
    SetBarState(SP_CLOSED, map);

    _ReturnTime(4, 0);
}

uint e_OpenSkumpitt(array<uint>@ values)
{
    Map@ map = GetMapByPid(MAP_JunktownNorth, 0);

     if(!valid(map)) {
        Log("Invalid map " + MAP_JunktownNorth);
        return 0;
    }

    Log("It's evening, Skumpitt is opening.");

    AddSkumpittPatrons();
    SetBarState(SP_OPENED, map);

    _ReturnTime(17, 0);
}

Critter@ GetCritterAtEntire(uint entireId, Map@ map)
{
    uint16 x = 0;
    uint16 y = 0;
    map.GetEntireCoords(entireId, 0, x, y);
    Critter@ cr = map.GetCritter(x, y);
    return cr;
}

// Spawn the Skumpitt bar patrons.
void AddSkumpittPatrons()
{
    Map@ map = GetMapByPid(MAP_JunktownNorth, 0);

    if(!valid(map))
        return;

    // remove Neal from the room.
    Critter@ cr = GetCritterAtEntire(10, map);
    if(valid(cr))
        DeleteNpc(cr);

    SpawnStaticNpc(map, 11, 58, 1759, 394, 0, 0, 0, 2, "", "");
    SpawnStaticNpc(map, 12, 58, 1762, 0, 0, 0, 0, 5, "", "");
    // The generic skull replication time.
    Critter@ genSkul = SpawnStaticNpc(map, 13, 89, 1748, 352, 0, 0, 0, 5, "", "");
    genSkul.StatBase[ST_REPLICATION_TIME] = REPLICATION_MINUTE(1);

    SpawnStaticNpc(map, 15, 61, 1747, 0, 0, 0, 0, 2, "", "");
    SpawnStaticNpc(map, 16, 72, 1748, 352, 0, 0, 0, 0, "", "");
    SpawnStaticNpc(map, 17, 69, 1754, 351, 0, 0, 0, 0, "", "");
    SpawnStaticNpc(map, 18, 69, 1753, 350, 0, 0, 0, 1, "", "");
    SpawnStaticNpc(map, 19, 142, 1758, 0, 0, 0, 0, 2, "", "");

    // Remove Trish at Crash hotel
    Map@ mapHotel = GetMapByPid(MAP_Junktownhotel, 0);

    if(!valid(mapHotel))
        return;
    
    Critter@ trish = GetCritterAtEntire(10, mapHotel);
    if(valid(trish))
        DeleteNpc(trish);
}

// Remove the Skumpitt bar patrons.
void RemoveSkumpittPatrons()
{
    Map@ map = GetMapByPid(MAP_JunktownNorth, 0);

    if(!valid(map))
        return;

    // remove Neal at the bar.
    Critter@ cr = GetCritterAtEntire(11, map);
    if(valid(cr))
        DeleteNpc(cr);


    // Add Neal to the room
    SpawnStaticNpc(map, 10, 58, 1759, 349, 0, 0, 0, 2, "", "");

    for(uint i = 11; i <= 19; i++)
    {
        Critter@ cr = GetCritterAtEntire(i, map);

        if(valid(cr))
            DeleteNpc(cr);
    }

     // Add Trish back to Crash hotel
    Map@ mapHotel = GetMapByPid(MAP_Junktownhotel, 0);

    if(!valid(mapHotel))
        return;

    SpawnStaticNpc(mapHotel, 10, 61, 1747, 0, 0, 0, 0, 0, "", "");
}
