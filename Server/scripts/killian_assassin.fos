// Garl leader of raiders, duel script

#include "_macros.fos"
#include "_defines.fos"
#include "messages_h.fos"
#include "npc_roles_h.fos"
#include "npc_planes_h.fos"
#include "mapdata_h.fos"

import void NpcSetLevel(Critter& npc, int level) from "parameters";
import bool d_WeaponInHand(Critter& player, Critter@ npc) from "dialog";

#define KILLIAN_PID (307)

void critter_init(Critter& cr, bool firstTime)
{
    cr.StatBase[ST_REPLICATION_TIME] = REPLICATION_DELETE_FAST;
    cr.ModeBase[MODE_NO_HOME] = 1;
    cr.SetEvent(CRITTER_EVENT_IDLE, "_MobIdle");
    cr.SetEvent(CRITTER_EVENT_DEAD, "_Dead");
    if(firstTime)
    {
        NpcSetLevel(cr, 10);
    }
}

void _MobIdle(Critter& cr)
{    
    // check critters in sight
    array<Critter@> crits;
    // get visible npcs    
    uint            num = cr.GetMap().GetCritters(0, FIND_ALL | FIND_ONLY_NPC, crits);
    for(uint i = 0; i < num; i++)
    {
        // attack
        uint npcId = crits[i].GetProtoId();
        if (npcId == KILLIAN_PID) {            
            int[] data = { crits[i].Id, cr.Id };
            CreateTimeEvent(AFTER(REAL_SECOND(1)), "e_Walk", data, false);
            return;
        }
    }
}

uint e_Walk(array<uint>@ values)
{    
    Critter@ assassin = GetCritter(values[1]);
    if(!valid(assassin))
        return 0;

    Map@ map = GetMapByPid(MAP_Junktownhotel, 0);
    if(!valid(map))
        return 0;
    
    uint16 x = 0;
    uint16 y = 0;
    map.GetEntireCoords(11, 0, x, y);
    Log("walking...");
    AddWalkPlane(assassin, AI_PLANE_WALK_PRIORITY, x, y, 5, false, 0);

    CreateTimeEvent(AFTER(REAL_SECOND(10)), "e_InitiateAttack", values, false);

    return 0;
}

uint e_InitiateAttack(array<uint>@ values)
{
    Log("attacking...");
    Critter@ killian = GetCritter(values[0]);
    Critter@ assassin = GetCritter(values[1]);
    if(!valid(killian) || !valid(assassin))
        return 0;
    assassin.Say(SAY_SHOUT_ON_HEAD, "Gizmo sends regards!");

    AddAttackPlane(assassin, 0, killian);
    return 0;
}

void _Dead(Critter& cr, Critter@ player)
{   
    Log("dead, trigger delete npc");     
    int[] values = { cr.Id };
    CreateTimeEvent(AFTER(REAL_SECOND(10)), "e_DeleteNPC", values, false);
}


uint e_DeleteNPC(array<uint>@ values)
{
    Log("delete...");    
    Critter@ assassin = GetCritter(values[0]);
    if(!valid(assassin))
        return 0;
    DeleteNpc(assassin);
    return 0;
}