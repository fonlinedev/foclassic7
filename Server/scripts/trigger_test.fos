#include "_defines.fos"
#include "_macros.fos"

#define DIALOG_1 (2911)
#define DIALOG_2 (2912)
#define DIALOG_3 (2913)

void t_NearTrigger1(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    if(!critter.IsPlayer() || !entered)
        return;
    
    if(entered && (dir==0 || dir==4 || dir==5))
    {
		critter.Wait( 0 );
		RunDialog(critter, DIALOG_1, trigger.HexX, trigger.HexY, false);
    }
}

