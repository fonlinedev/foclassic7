// dialog ids
#define SETH_DIALOG1 4010
#define SETH_DIALOG2 4029
#define ARADESH_DIALOG1 4009
#define ARADESH_DIALOG2 4041
#define ARADESH_DIALOG3 4028
#define IAN_DIALOG 4017
#define TANDI_DIALOG1 4026

// npc pids
#define SETH_PID 67
#define ARADESH_PID 206
#define IAN_PID 32
#define TANDI_PID 68

void map_init(Map& map, bool firstTime)
{    
    uint[] values = { map.GetProtoId() };
    
    map.SetEvent(MAP_EVENT_IN_CRITTER, "_CritterIn");
    map.SetEvent(MAP_EVENT_OUT_CRITTER, "_CritterOut");
    CreateTimeEvent(AFTER(REAL_MINUTE(5)), "cte_SpawnIan", values, false);
    if(firstTime)
    {
        map.SetTurnBasedAvailability(true);
        spawnIan(map);
    }
}
// verify Ian presence
uint cte_SpawnIan(array<uint>@ values) {
    if(values is null || values.length() == 0) return 0;
    uint mapPid = values[0];
    Map@ map = GetMapByPid(mapPid, 0);

    if(!valid(map))
    {
        Log("cte_SpawnIan failed, map " + mapPid + " not found.");
        return 0;
    }
    uint16 x = 0;
    uint16 y = 0;

    map.GetEntireCoords(11, 0, x, y);

    Critter@ cr = map.GetCritter(x, y);
    if (!valid(cr)) {
        Log("IAN not found, spawning back");
        spawnIan(map);
    }
    return REAL_MINUTE(5);
}

void spawnSeth(Map@ map)
{
    Critter@ cr = SpawnStaticNpc(
        map,
        10,                 // entire id
        SETH_PID,
        SETH_DIALOG1,
        167,                // bag
        FACTION_NCR,
        1,                  // faction mode
        1,                  // faction rank
        5,                  // direction
        "seth@critter_init",
        "Seth"
    );
    if (!valid(cr))
        Log("Error at seth spawning");
}

void spawnAradesh(Map& map)
{
    Critter@ cr = SpawnStaticNpc(
        map,
        12,                 // entire id
        ARADESH_PID,
        ARADESH_DIALOG1,
        6,                // bag
        FACTION_NCR,
        1,                  // faction mode
        1,                  // faction rank
        3,                  // direction
        "",
        "Aradesh"
    );
    if (!valid(cr))
        Log("Error at aradesh spawning");
    
}

// IAN can be removed by the player, update this to respawn automatically.
void spawnIan(Map& map)
{

    Critter@ cr = SpawnStaticNpc(
        map,
        11,                 // entire id
        IAN_PID,
        IAN_DIALOG,
        7,                // bag
        FACTION_NCR,
        1,                  // faction mode
        0,                  // faction rank
        2,                  // direction
        "",
        "Ian"
    );
    if (!valid(cr))
        Log("Error at IAN spawning");

}
// Tandi must be removed if the quest started
void spawnTandi(Map& map)
{
    Critter@ cr = SpawnStaticNpc(
        map,
        13,                 // entire id
        TANDI_PID,
        TANDI_DIALOG1,
        3,                // bag
        FACTION_NCR,
        1,                  // faction mode
        1,                  // faction rank
        3,                  // direction
        "",
        "TANDI"
    );
    if (!valid(cr))
        Log("Error at Tandi spawning");
        
}

void _CritterIn(Map& map, Critter& cr)
{
    if (!cr.IsPlayer())
        return;

    Map@   player_map = cr.GetMap();
    if(valid(player_map))
    {
        spawnSeth(player_map);
        spawnAradesh(player_map);

        GameVar@ qVar = GetLocalVar(LVAR_q_shady_tandi, cr.Id);
        if (valid(qVar)) {
            if (qVar.GetValue() >= 1 && qVar.GetValue() <= 5) {
                return;
            }   
            if (qVar.GetValue() == 0)
                spawnTandi(player_map);
        } else {
            Log("ERROR Tandi var invalid");
        }
    }
}

bool d_TandiFollower(Critter& player, Critter@ npc)
{
    return isTandiFollower(player);
}

void r_CompleteTandiRescue(Critter& player, Critter@ npc)
{    
    ReturnTandi(player);
}

void ReturnTandi(Critter& cr)
{
    Map@ map = cr.GetMap();
    GameVar@ tandiVar = GetLocalVar(LVAR_q_shady_tandi, cr.Id);
    if (!valid(tandiVar)) {
        Log("q_shady_tandi invalid state.");
        return;
    }
    array<Critter@> crits;
    int n = GetFollowers(cr, map, crits);
    for(int i = 0; i < n; i++)
    {
        uint npcId = crits[i].GetProtoId();
        if (npcId == TANDI_PID) {
            Log("tandi is a follower, removing.");
            tandiVar = 6;
            crits[i].StatBase[ST_FREE_BARTER_PLAYER] = 0;
            SetGroupInfo(crits[i], FACTION_UNKNOWN, 0, FACTION_MODE_PASSIVE);
            crits[i].FollowerVarBase[FV_MASTER] = 0;
            cr.FollowersBase[i] = 0;
            DeleteNpc(crits[i]);
            break;
        }
    }
    Log("respawn tandi");
    spawnTandi(map);
}

void _CritterOut(Map& map, Critter& cr)
{
}

Critter@ SpawnStaticNpc(
    Map@ map,
    uint coord,
    uint pid,
    uint dialog,
    uint bag,
    uint team,
    uint factionMode,
    uint factionRank,
    uint dir,
    string initFunc,
    string name)
{
    uint16 x = 0;
    uint16 y = 0;

    map.GetEntireCoords(coord, 0, x, y);

    Critter@ cr = map.GetCritter(x, y);

    if (!valid(cr))
    {
        int[] params = {
            ST_DIALOG_ID, dialog,
            ST_BAG_ID, bag,
            ST_TEAM_ID, team,
            ST_FACTION_MODE, factionMode,
            ST_FACTION_RANK, factionRank,
            MODE_NO_LOOT, 1,
            MODE_NO_STEAL, 1
        };

        @cr = map.AddNpc(
            pid,
            x,
            y,
            dir,
            params,
            null,
            initFunc
        );

        if (!valid(cr))
        {
            Log("Error creating " + name);
            return null;
        }

        Log(name + " spawned");
    }
    else
    {
        Log(name + " already exists, updating");
        if (name == "Aradesh") {
            UpdateAradesh(cr, map);
        }
        if (name == "Seth") {
            UpdateSeth(cr, map);
        }
    }

    return cr;
}

void UpdateSeth(Critter@ cr, Map@ map)
{
    // Seth-specific logic~
    array<Critter@> crits;
    uint n = map.GetCritters(0, FIND_ALL | FIND_ONLY_PLAYERS, crits);

    Critter@ player = null;

    for(uint i = 0; i < n; i++)
    {
        if(crits[i].IsPlayer())
        {
            @player = crits[i];
            break;            
        }
    }
    
    if (!valid(player))
        return;
    Log("update seth");
    GameVar@ qVar = GetLocalVar(LVAR_q_shady_tandi, player.Id);
    if (!valid(qVar))
        return;
    if (qVar.GetValue() >= 1 && qVar.GetValue() <= 5) {
        Log("SETH: tandi rescue not finished update to dialog 2");
        cr.StatBase[ST_DIALOG_ID] = SETH_DIALOG2;
        return;
    }
    if (qVar.GetValue() == 6) {
        Log("SETH: tandi rescue finalized back to dialog 1");
        cr.StatBase[ST_DIALOG_ID] = SETH_DIALOG1;
        return;
    }
}

// Aradesh-specific logic
void UpdateAradesh(Critter@ cr, Map@ map)
{
    array<Critter@> crits;
    uint n = map.GetCritters(0, FIND_ALL | FIND_ONLY_PLAYERS, crits);

    Critter@ player = null;

    for(uint i = 0; i < n; i++)
    {
        if(crits[i].IsPlayer())
        {
            @player = crits[i];
            break;            
        }
    }

    if (!valid(player))
        return;

    GameVar@ q1Var = GetLocalVar(LVAR_q_shady_radscorpions, player.Id);
    GameVar@ q2Var = GetLocalVar(LVAR_q_shady_antidote, player.Id);
    GameVar@ qVar = GetLocalVar(LVAR_q_shady_tandi, player.Id);
    if(!valid(q1Var) || !valid(q2Var) || !valid(qVar))
        return;
    
    if (qVar.GetValue() >= 1 && qVar.GetValue() <= 5) {
        return;
    }
    if (qVar.GetValue() == 6) {
        Log("tandi rescue done reset aradesh");
        cr.StatBase[ST_DIALOG_ID] = ARADESH_DIALOG1;
        return;
    }
    
    if(q1Var.GetValue() > 0 && q1Var.GetValue() < 3)
    {
        Log("Radscorpions quest is ongoing");
        cr.StatBase[ST_DIALOG_ID] = ARADESH_DIALOG2;
        return;
    }

    if(q1Var.GetValue() == 3 && q2Var.GetValue() == 1)
    {
        Log("Radscorpions quest is done, can start Tandi rescue.");
        cr.StatBase[ST_DIALOG_ID] = ARADESH_DIALOG3;
        Critter@ tandi = GetNpcByEntire(map, 13);
        if (!valid(tandi)) {
            Log("Tandi isn't present...");
            return;
        }
        DeleteNpc(tandi);
    }
}

Critter@ GetNpcByEntire(Map@ map, uint coord)
{
    uint16 x = 0;
    uint16 y = 0;
    map.GetEntireCoords(coord, 0, x, y);
    Critter@ cr = map.GetCritter(x, y);
    return cr;
}

