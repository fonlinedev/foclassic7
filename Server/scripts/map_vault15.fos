#include "_defines.fos"
#include "lockers_utils.fos"

#define DIALOG_LEVEL3_ID  (4023)

#define Q_NOT_STARTED    (0)
#define Q_INVESTIGATED   (1)

void map_init(Map& map, bool firstTime)
{
    _MapSetMode(map, MAP_MODE_NO_PVP);
    _MapSetMode(map, MAP_MODE_NO_LOOT_DROP);
    uint[] values = { map.GetProtoId() };
    uint respawnTime = 1; // 1 hour loop
    CreateTimeEvent(__FullSecond + REAL_HOUR(respawnTime), "e_RespawnLoot", values, false);
    if(firstTime)
    {       
        map.SetTurnBasedAvailability(true);
        initLockers(map);     
    }
}

void s_Dialog(Critter& critter, Scenery& trigger, bool entered, uint8 dir, int dialogId)
{    
    if(!critter.IsPlayer() || !entered)
        return;
        
    RunDialog(critter, dialogId, critter.HexX, critter.HexY, false);
}

void t_FinishInvestigation(Critter& critter, Scenery& trigger, bool entered, uint8 dir)
{
    if(!critter.IsPlayer() || !entered)
        return;
    RunDialog(critter, DIALOG_LEVEL3_ID, critter.HexX, critter.HexY, false);
}

void t_Level3Clues(Critter& critter, Scenery& trigger, bool entered, uint8 dir, int clueId)
{
    if(!critter.IsPlayer() || !entered)
        return;    
    critter.SayMsg(SAY_NETMSG, TEXTMSG_DLG, DLGSTR(DIALOG_LEVEL3_ID, clueId));
}

void r_AdvanceQuest(Critter& player, Critter@ npc) {
    GameVar@ quest = GetLocalVar(LVAR_quest_water_chip, player.Id);
    if (valid(quest))
        quest = 2;
}

uint e_RespawnLoot(uint[]@ values)
{
    if(values is null || values.length() == 0) return 0;
    uint mapPid = values[0];
    Map@ map = GetMapByPid(mapPid, 0);
    if(!valid(map))
    {
        Log("initLockers failed, map " + mapPid + " not found.");
        return 0;
    }
    initLockers(map);
    return REAL_HOUR(1);
}

void initLockers(Map@ map) {
    
    clearLockers(map);
    if (map.GetProtoId() == MAP_Vault15Level1) {        
        // 1st level
        AddItemToMapItem(map, 60, 60, PID_WALL_LOCKER_RUSTY_RIGHT, PID_FLARE, 6);
        AddItemToMapItem(map, 46, 42, PID_WALL_LOCKER_RUSTY_RIGHT, PID_STIMPAK, 4);
        AddItemToMapItem(map, 46, 42, PID_WALL_LOCKER_RUSTY_RIGHT, PID_FIRST_AID_KIT, 1);
    } else if (map.GetProtoId() == MAP_Vault15Level2) {
        
        // 2nd level PID_LOCKER_8
        AddItemToMapItem(map, 87, 75, PID_LOCKER_8, PID_DEANS_ELECTRONICS, 1);
        AddItemToMapItem(map, 87, 75, PID_LOCKER_8, PID_FIRST_AID_BOOK, 1);
        AddItemToMapItem(map, 87, 75, PID_LOCKER_8, PID_MULTI_TOOL, 1);
        AddItemToMapItem(map, 63, 75, PID_LOCKER_8, PID_LEATHER_JACKET, 1);
        AddItemToMapItem(map, 63, 75, PID_LOCKER_8, PID_ROPE, 1);
        AddItemToMapItem(map, 51, 76, PID_LOCKER_8, PID_DOCTORS_BAG, 1);
        AddItemToMapItem(map, 51, 76, PID_LOCKER_8, PID_LOCKPICKS, 1);
        AddItemToMapItem(map, 51, 76, PID_LOCKER_8, PID_BIG_BOOK_OF_SCIENCE, 1);
    } else if (map.GetProtoId() == MAP_Vault15Level3) {
        
        // 3rd level PID_LOCKER_8        
        //grenade x2, 1x dynamite
        AddItemToMapItem(map, 54, 66, PID_LOCKER_7, PID_FRAG_GRENADE, 2);
        AddItemToMapItem(map, 54, 66, PID_LOCKER_7, PID_DYNAMITE, 1);
        // 1 SMG, 50x 10mm JHP
        AddItemToMapItem(map, 52, 66, PID_LOCKER_7, PID_10MM_SMG, 1);
        AddItemToMapItem(map, 52, 66, PID_LOCKER_7, PID_10MM_JHP, 50);
        // PID_RADAWAY
        AddItemToMapItem(map, 77, 50, PID_LOCKER_7, PID_DESERT_EAGLE, 1);
        AddItemToMapItem(map, 77, 50, PID_LOCKER_7, PID_5MM_JHP, 50);
        AddItemToMapItem(map, 77, 50, PID_LOCKER_7, PID_RADAWAY, 3);
    }
}

void clearLockers(Map& map)
{
    if (map.GetProtoId() == MAP_Vault15Level1) {        
        // 1st level
        Item@ entrance = map.GetItem(60, 60, PID_WALL_LOCKER_RUSTY_RIGHT);
        Item@ medical = map.GetItem(46, 42, PID_WALL_LOCKER_RUSTY_RIGHT);
        ClearLocker(entrance);
        ClearLocker(medical);
    } else if (map.GetProtoId() == MAP_Vault15Level2) {        
        Item@ lvl2_1 = map.GetItem(87, 75, PID_LOCKER_8);
        Item@ lvl2_2 = map.GetItem(63, 75, PID_LOCKER_8);
        Item@ lvl2_3 = map.GetItem(51, 79, PID_LOCKER_8);
        // 2nd level PID_LOCKER_8
        ClearLocker(lvl2_1);
        ClearLocker(lvl2_2);
        ClearLocker(lvl2_3);
    } else if (map.GetProtoId() == MAP_Vault15Level3) {        
        // 3rd level PID_LOCKER_8        
        //grenade x2, 1x dynamite
        Item@ lvl3_1 = map.GetItem(54, 66, PID_LOCKER_7);
        ClearLocker(lvl3_1);        
        // 1 SMG, 50x 10mm JHP
        Item@ lvl3_2 = map.GetItem(52, 66, PID_LOCKER_7);
        ClearLocker(lvl3_2);
        // PID_RADAWAY
        Item@ lvl3_3 = map.GetItem(77, 50, PID_LOCKER_7);
        ClearLocker(lvl3_3);        
    }
}

void AddItemToMapItem(Map& map, int hexX, int hexY, int pid, int itemPid, uint count)
{
    Item@ item = map.GetItem(hexX, hexY, pid);

    if(!valid(item))
        return;

    item.AddItem(itemPid, count, 0);
}
