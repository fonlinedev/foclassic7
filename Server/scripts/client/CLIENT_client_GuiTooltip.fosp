		uint craftXpSkillNum=GetCraftingSkillNumByCraftPid(item);
		if(craftXpSkillNum>=200&&craftXpSkillNum<=218){
			text+="\nCraft passive skill gain: "+GetMsgStr((3),(100001+(craftXpSkillNum)*10));
			uint craftXpValue=GetCraftXpByPid(item.GetProtoId());
			if(craftXpValue>0){
				text+="\nCraft material base xp value: "+craftXpValue;
				for(int skillNum=(209);skillNum<=(217);skillNum++){
					if(skillNum==(209)||skillNum==(213)||skillNum==(212)||skillNum==(217)){
						int skill=chosen.Skill[skillNum];
						int componentDiminisher=(skill>150?5:(skill>125?4:(skill>100?3:(skill>75?2:(skill>50?1:0)))));
						int craftXpValueCurrent=(((craftXpValue-componentDiminisher)>(7))?(7):(((craftXpValue-componentDiminisher)<(0))?(0):(craftXpValue-componentDiminisher)));
						text+="\n\t\u2022 "+GetMsgStr((3),(100001+(skillNum)*10))+": "+craftXpValueCurrent;
					}
				}
			}
		} 
		
		if(item.IsDeteriorable()){
			uint8 flags=item.BrokenFlags;
			uint8 brokenCount=item.BrokenCount;
			uint16 wearCount=item.Deterioration; 
			
			text+="\n\n";
			if((((flags)&((0x08)))!=0)){
				text+="|"+((uint((0xFF<<24)|(((0x7F)&0xFF)<<16)|(((0x7F)&0xFF)<<8)|((0x7F)&0xFF))))+" "+GetMsgStr((3),(506))+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			}else if((((flags)&((0x01)))!=0)){
				text+=GetMsgStr((3),(503));
			}else if((((flags)&((0x02)))!=0)){
				text+=GetMsgStr((3),(504));
			}else if((((flags)&((0x04)))!=0)){
				text+=GetMsgStr((3),(505));
			}else{
				int deterCurrent=100-wearCount*100/(10000);
				int deterMax=100-brokenCount;
				string currentColor="";
				if(deterCurrent>75){
					currentColor=" |"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))));
				}else if(deterCurrent>50){
					currentColor=" |"+((uint((0xFF<<24)|(((0xaa)&0xFF)<<16)|(((0xaa)&0xFF)<<8)|((0)&0xFF))));
				}else if(deterCurrent>25){
					currentColor=" |"+((uint((0xFF<<24)|(((0xff)&0xFF)<<16)|(((0xa5)&0xFF)<<8)|((0)&0xFF))));
				}else{
					currentColor=" |"+((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF))));
				}
				currentColor+=" "+deterCurrent;
				string maxColor="";
				if(deterMax>75){
					maxColor="|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))));
				}else if(deterMax>50){
					maxColor="|"+((uint((0xFF<<24)|(((0xaa)&0xFF)<<16)|(((0xaa)&0xFF)<<8)|((0)&0xFF))));
				}else if(deterMax>25){
					maxColor="|"+((uint((0xFF<<24)|(((0xff)&0xFF)<<16)|(((0xa5)&0xFF)<<8)|((0)&0xFF))));
				}else{
					maxColor="|"+((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF))));
				}
				maxColor+=" "+deterMax;
				text+=ReplaceText(ReplaceText(GetMsgStr((3),(500)),"VALUE",currentColor),"MAXVALUE",maxColor);
				text+="|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			} 
			
			if((((flags)&((0x10)))!=0)){
				text+="\n"+GetMsgStr((3),(501));
			} 
			
			if((((flags)&((0x20)))!=0)){
				text+="\n"+GetMsgStr((3),(502));
			}
		}
		text+="\nBase price: "+item.Proto.Cost;              
		
		string weightString=GetMsgStr((3),(435));
		if(item.Proto.Weight*item.GetCount()==1){
			weightString=ReplaceText(weightString,"grams.","gram.");
		}
		string ammoWeightReplaceString="";
		int totalWeight=item.Proto.Weight*item.GetCount();
		string totalWeightString="";
		if(item.GetCount()>1&&item.Proto.Weight>0){
			totalWeightString+="  ("+item.GetCount()+" * "+item.Proto.Weight+"g)";
		}
		if(ammoCount>0){
			totalWeight+=ammoWeight*ammoCount;
			ammoWeightReplaceString="  ("+(item.Proto.Weight*item.GetCount())+"g + "+ammoCount+" * "+ammoWeight+"g)";
		}
		text+="\n\n"+ReplaceText(weightString,"VALUE",""+totalWeight)+totalWeightString+ammoWeightReplaceString;
	}else{
		text="N/A - Invalid Item";
	}
	int h=inventoryTooltip.interfaceTextbox.setText(text);
	inventoryTooltip.interfaceWindow.totalHeight=20+h;
	inventoryTooltip.interfaceWindow.posY-=inventoryTooltip.interfaceWindow.totalHeight;
} 

void DrawCharacterTooltip(){
	string pipExtInfo="\t\t\t\t\t\t|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0x66)&0xFF)<<8)|((0)&0xFF))))+" <<Hold Shift for extended pip-search results>>";
	if(GUI_IsKeyPressed(0x2A)||GUI_IsKeyPressed(0x36)){
		SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId)+tooltipKeyValue.getToolTipExt(characterTooltip.currentTooltipId));
	}else{
		SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId)+pipExtInfo);
	}
	characterTooltip.Draw();
} 

void DrawInventoryTooltip(){
	inventoryTooltip.Draw();
} 

bool CharacterTooltipCatchMouseRelease(int click){
	if(!characterTooltip.enabled){
		return false;
	}else{
		characterTooltip.enabled=false;
		return true;
	}
}

class CGuiTooltip{
	bool enabled;
	int currentTooltipId;
	int posX,posY;
	CInterfaceWindow interfaceWindow;
	CInterfaceTextbox interfaceTextbox;
	CInterfaceTextbox interfaceTextboxComparison;
	
	CGuiTooltip(){
		enabled=false;
	}
	
	CGuiTooltip(int id){
		currentTooltipId=id;
		enabled=false;
	}
	
	void Draw(){
		if(!enabled){
			
			return;
		}
		interfaceWindow.DrawWindow();
	}
};         

int getWeaponSizeRank(ProtoItem&item){
	int weaponRank=(0);
	if(!(@item!=null)){
		return weaponRank;
	}
	
	int skill=item.Weapon_Skill_0;
	
	switch(skill){
		case(203):
		case(205):
		weaponRank=(1);
		break;
		case(200):
		weaponRank=(3);
		break;
		case(202):
		weaponRank=(3);
		break;
		case(201):
		weaponRank=(4);
		break;
	}
	
	uint itemPid=item.ProtoId;
	switch(itemPid){
		
		case(9):
		case(296):
		case(332):
		case(352):
		case(391):
		case(8):
		case(22):
		case(122):
		case(18):
		case(404):
		case(241):
		case(313):
		case(398):
		case(388):
		case(300):
		case(394):
		
		case(16):
		case(402):
		case(24):
		case(406):
		case(120):
		case(396):
		case(390):
		case(393):
		case(625):
		weaponRank=(2);
		break; 
		
		case(11):
		case(400):
		weaponRank=(3);
		break; 
		
		case(28):
		weaponRank=(4);
		break;
	}
	return weaponRank;
}

string getWeaponSizeRankDescription(int value){
	switch(value){
		case 1:return"Melee";
		case 2:return"Light";
		case 3:return"Medium";
		case 4:return"Heavy";
	}
	return"Unranked";
}        

uint GetCraftingSkillNumByCraftPid(ItemCl&item){
	const ProtoItem@proto=item.Proto;
	int craftSkillNum=0;
	
	if(proto.Type==(3)){
		int weaponSkillNum=proto.Weapon_Skill_0;
		switch(weaponSkillNum){
			case(202):
			craftSkillNum=(212);
			break;
			default:
			craftSkillNum=(213);
		}
		switch(proto.ProtoId){
			case(160):
			case(399):
			case(407):
			case(235):
			craftSkillNum=(212);
			break;
			case(7):
			case(320):
			case(280):
			case(4):
			case(45):
			case(159):
			case(6):
			case(289):
			craftSkillNum=(217);
			break;
			default:
		}
		
	}else if(proto.Type==(1)){
		switch(proto.ProtoId){
			case(1):
			case(730):
			case(74):
			case(728):
			craftSkillNum=(217);
			break;
			case(240):
			case(734):
			craftSkillNum=(212);
			break;
			default:
			craftSkillNum=(213);
		}
		
	}else if(proto.Type==(2)){
		switch(proto.ProtoId){
			case(9655):
			case(273):
			case(49):
			craftSkillNum=(217);
			break;
			default:
			craftSkillNum=(212);
		}
		
	}else if(proto.Type==(4)){
		switch(proto.ProtoId){
			case(38):
			case(39):
			craftSkillNum=(212);
			break;
			default:
			craftSkillNum=(213);
		}
		
	}else{
		switch(proto.ProtoId){
			case(549):
			case(84):
			case(410):
			case(77):
			case(411):
			craftSkillNum=(209);
			break;
			case(543):
			case(605):
			case(609):
			case(3856):
			case(1863):
			case(100):
			case(101):
			case(127):
			case(79):  
			
			case(9851):
			craftSkillNum=(217);
			break;
			case(1804):
			case(9653):
			case(1802):
			case(9628):
			case(535):
			case(9631):
			case(75):
			case(654):
			case(652):
			case(521):
			case(662):
			case(660):
			case(664):
			case(666):
			case(656):
			case(650):
			craftSkillNum=(213);
			break;
			default:
			craftSkillNum=0;
		}
		
	}
	
	return craftSkillNum;
}  

int GetCraftXpByPid(uint pid){
	switch(pid){
		case(536):
		case(537):
		case(535):
		case(284):
		case(9627):
		return 1;
		case(469):
		case(1824):
		case(286):
		case(278):
		case(98):
		case(1804):
		case(272):
		case(271):
		case(71):
		case(539):
		case(127):
		case(276):
		case(9635):
		case(9629):
		case(318):
		case(9634):
		case(9631):
		case(1802):
		case(1801):
		case(9633):
		return 3;
		case(440):
		case(1803):
		case(277):
		return 4;
		case(9632):
		case(9919):
		return 6;
		case(9630):
		case(9918):
		case(9653):
		case(9628):
		case(426):
		return 7;
		default:
		return 0;
	}
	return 0;
} 

