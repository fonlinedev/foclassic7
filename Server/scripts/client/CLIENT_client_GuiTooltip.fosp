void RefreshTooltips(bool forced){
	
	if(forced){
		InitCharacterTooltip();
		LogToolTips("Tooltips refresh FORCED!");
		return;
	}
	if(tooltipRefreshDelay>0&&tooltipRefreshDelay<GetTick()){
		tooltipRefreshDelay=0;
		InitCharacterTooltip();
		LogToolTips("Tooltips refreshed by delay!");
		return;
	}
	
	CritterCl@chosen=GetChosen();
	if(!(@chosen!=null)){
		chosenIsInvalid=false;
	}else if(!chosenIsInvalid){
		chosenIsInvalid=true;
		InitCharacterTooltip();
		LogToolTips("Tooltips refreshed!");
	}
}  

void RefreshTooltipsDelayed(uint delayInMs){
	if(tooltipRefreshDelay<GetTick()){
		tooltipRefreshDelay=GetTick()+delayInMs;
		LogToolTips("Tooltips refresh DELAYED by: "+delayInMs);
		RefreshTooltips(true);
	}else{
		LogToolTips("Tooltips refresh already under DELAYED effect!");
	}
} 

void InitCharacterTooltip(){
	tooltipKeyValue=CTooltips();
} 

void InitInventoryTooltip(){
	tooltipKeyValue=CTooltips();
} 

void UpdateCharacterTooltip(int tooltipId,int posX,int posY){
	if((@characterTooltip!=null)&&tooltipId<0){
		characterTooltip.enabled=false;
		return;
	}
	
	characterTooltip=CGuiTooltip(tooltipId);
	
	if((@characterTooltip!=null)){
		characterTooltip.enabled=false;
	}
	
	characterTooltip.posX=posX;
	characterTooltip.posY=posY;
	int x=posX;
	int y=posY;
	if(uint(tooltipId)>=((__SkillBegin))&&uint(tooltipId)<((__SkillBegin))+(((__SkillEnd))-((__SkillBegin))+1)||GUI_GetActiveScreen()==(32)){
		characterTooltip.interfaceWindow=CInterfaceWindow(x-620-30,y,620,100);
	}else{
		characterTooltip.interfaceWindow=CInterfaceWindow(x+20,y,620,100);
	}
	
	characterTooltip.interfaceWindow.maxWidth=__ScreenWidth*4/5;
	characterTooltip.interfaceWindow.maxHeight=__ScreenHeight*4/5;
	characterTooltip.interfaceWindow.backgroundColor=(uint((((230)&0xFF)<<24)|(((0)&0xFF)<<16)|(((0)&0xFF)<<8)|((0)&0xFF)));
	
	characterTooltip.interfaceTextbox=CInterfaceTextbox(10,10,600,800);
	characterTooltip.interfaceTextbox.Init();
	characterTooltip.interfaceTextbox.SetFont((5));
	characterTooltip.interfaceTextbox.textColor=((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))));
	
	SetCharacterDetailText(tooltipKeyValue.getToolTip(tooltipId));
	
	characterTooltip.interfaceWindow.posY-=characterTooltip.interfaceWindow.totalHeight;
	characterTooltip.posY=characterTooltip.interfaceWindow.posY;
	
	characterTooltip.interfaceWindow.childControls.insertLast(characterTooltip.interfaceTextbox);
	characterTooltip.interfaceWindow.FitScreen();
	characterTooltip.enabled=true;
	
} 

void UpdateInventoryTooltip(ItemCl&item,int left,int right,int top,int bottom,bool preferLeft){
	if(!(@inventoryTooltip!=null)){
		lastInventoryItemId=0;
		return;
	}
	if(!(@item!=null)){
		lastInventoryItemId=0;
		inventoryTooltip.enabled=false;
		return;
	}
	if(item.Id==lastInventoryItemId){
		return;
	}else{
		lastInventoryItemId=item.Id;
	} 
	
	inventoryTooltip=CGuiTooltip();
	
	if((@inventoryTooltip!=null)){
		inventoryTooltip.enabled=false;
	}  
	
	int x=left;
	int y=top;
	inventoryTooltip.interfaceWindow=CInterfaceWindow(x+20,y,320,100);
	
	inventoryTooltip.interfaceWindow.maxWidth=__ScreenWidth*4/5;
	inventoryTooltip.interfaceWindow.maxHeight=__ScreenHeight*4/5;
	inventoryTooltip.interfaceWindow.backgroundColor=(uint((((230)&0xFF)<<24)|(((0)&0xFF)<<16)|(((0)&0xFF)<<8)|((0)&0xFF)));
	inventoryTooltip.interfaceTextbox=CInterfaceTextbox(10,10,300,800);
	inventoryTooltip.interfaceTextbox.Init();
	inventoryTooltip.interfaceTextbox.textColor=(uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xD8)&0xFF)<<8)|((0)&0xFF)));
	inventoryTooltip.interfaceTextbox.SetFont((5));
	
	inventoryTooltip.interfaceTextboxComparison=CInterfaceTextbox(10,10,100,200);
	inventoryTooltip.interfaceTextboxComparison.Init();
	inventoryTooltip.interfaceTextboxComparison.textColor=(uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xD8)&0xFF)<<8)|((0)&0xFF))); 
	
	SetInventoryDetailText(item);
	inventoryTooltip.interfaceWindow.childControls.insertLast(inventoryTooltip.interfaceTextbox);
	inventoryTooltip.interfaceWindow.childControls.insertLast(inventoryTooltip.interfaceTextboxComparison);
	
	inventoryTooltip.interfaceWindow.FitScreen(left,right,top,bottom,preferLeft);
	inventoryTooltip.enabled=true;
	
} 

void SetCharacterDetailText(string&text){
	int h=characterTooltip.interfaceTextbox.setText(text);
	characterTooltip.interfaceWindow.totalHeight=20+h;
	
}

void SetInventoryDetailText(ItemCl&item){
	CritterCl@chosen=GetChosen();
	if(!(@chosen!=null)){
		return;
	}
	
	string itemQualityPrefix="";
	if((@item!=null)){
		if(item.GetType()==(1)||item.GetType()==(3)){
			if(item.Val4!=0)itemQualityPrefix+="|"+((uint((0xFF<<24)|(((0x8F)&0xFF)<<16)|(((0x6F)&0xFF)<<8)|((0)&0xFF))))+" Unique "+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			else if(item.Val3!=0)itemQualityPrefix+="|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0xC8)&0xFF))))+" Advanced "+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			else if(item.Val2!=0)itemQualityPrefix+="|"+((uint((0xFF<<24)|(((0xFF)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0xFF)&0xFF))))+" Superior "+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			else if(item.Val1!=0)itemQualityPrefix+="|"+((uint((0xFF<<24)|(((0xAB)&0xFF)<<16)|(((0xAB)&0xFF)<<8)|((0xAB)&0xFF))))+" Improved "+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
			else if(item.Val0!=0)itemQualityPrefix+="|"+((uint((0xFF<<24)|(((0x7F)&0xFF)<<16)|(((0x7F)&0xFF)<<8)|((0x7F)&0xFF))))+" Quality "+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xFF)&0xFF)<<8)|((0)&0xFF))))+" ";
		}
	}
	
	string textComparison="";
	string text=""+itemQualityPrefix;
	if((@item!=null)){
		text+=GetMsgStr((2),(item.GetProtoId()*100+item.Info))+"\n\n";
		text+=GetMsgStr((2),(item.Proto.ProtoId*100)+1)+"\n";
		int ammoCount=0;
		int ammoWeight=0;
		if(item.GetType()==(3)){
			if(item.Proto.Weapon_Skill_0>=200&&item.Proto.Weapon_Skill_0<=218){
				text+="\nSkill: "+GetMsgStr((3),(100001+(item.Proto.Weapon_Skill_0)*10));
				if(item.Proto.Weapon_ActiveUses>1&&item.Proto.Weapon_Skill_0!=item.Proto.Weapon_Skill_1&&item.Proto.Weapon_Skill_1>=200&&item.Proto.Weapon_Skill_1<=218){
					text+=" / "+GetMsgStr((3),(100001+(item.Proto.Weapon_Skill_1)*10));
				}
			}
			if(item.Proto.Weapon_MinStrength>1){
				text+="\nMinimum Strength: "+item.Proto.Weapon_MinStrength;
			}
			if(item.Proto.Weapon_MaxDist_0>0){
				uint16 rounds=((0)==0?item.Proto.Weapon_Round_0:((0)==1?item.Proto.Weapon_Round_1:((0)==2?item.Proto.Weapon_Round_2:0)));
				bool isBurst=rounds>1;
				if(isBurst){
					text+="\nBurst range: "+item.Proto.Weapon_MaxDist_0;
				}else{
					text+="\nRange: "+item.Proto.Weapon_MaxDist_0;
				}
				if(item.Proto.Weapon_MaxDist_1>0){
					uint16 rounds=((1)==0?item.Proto.Weapon_Round_0:((1)==1?item.Proto.Weapon_Round_1:((1)==2?item.Proto.Weapon_Round_2:0)));
					bool isBurst=rounds>1;
					if(isBurst){
						text+="\t(Burst range: "+item.Proto.Weapon_MaxDist_1+")";
					}else if(item.Proto.Weapon_Anim2_1==(53)){
						text+="\t(Throw range: "+item.Proto.Weapon_MaxDist_1+")";
					}
				}
			}
			if(item.Proto.Weapon_DmgMin_0>0&&item.Proto.Weapon_DmgMax_0>0){
				text+="\nBase damage: "+item.Proto.Weapon_DmgMin_0+"-"+item.Proto.Weapon_DmgMax_0;
			}
			
			if(item.Proto.Weapon_MaxAmmoCount>0){
				text+="\n";
				string str=GetMsgStr((3),(434));
				str=ReplaceText(str,"VALUE",item.AmmoCount);
				str=ReplaceText(str,"MAX_VALUE",item.Proto.Weapon_MaxAmmoCount);
				if(item.AmmoCount>0){
					str=ReplaceText(str,"AMMO",GetMsgStr((2),(item.AmmoPid*100)));
				}else{
					str=ReplaceText(str,"AMMO",GetMsgStr((3),(10900+(item.Proto.Weapon_Caliber))));
				}
				text+=str;
				if(item.AmmoCount>0){
					ProtoItem@ammo=GetProtoItem(item.AmmoPid);
					if((@ammo!=null)){
						ammoCount=item.AmmoCount;
						ammoWeight=ammo.Weight;
					}
				}
			}
			if(IsDetectHiddenWeapon(item)){
				text+="\nReveal hidden once:";
				text+="\n\tReveal radius on lit: "+(12);
				text+="\n\tReveal radius on thrown hex: "+(12);
				text+="\nReveal hidden per pulse:";
				text+="\n\tMust be in any hands or on the ground.";
				text+="\n\tReveal radius per pulse: "+(6);
				text+="\n\tPulse frequency: "+(2)+"-"+(3)+" seconds.";
				text+="\n\tPulse count: "+(180);
				text+="\n\tLifetime after lit: "+((2)*(180)/60)+"-"+((3)*(180)/60)+" minutes.";
			}
			if(item.Proto.Weapon_Perk!=0){
				string str=GetMsgStr((3),(10850+(item.Proto.Weapon_Perk)));
				text+="\nPerk: "+str+".";
			}
			text+="\nWeapon size category: "+getWeaponSizeRankDescription(getWeaponSizeRank(item.Proto))+"\n";
		}else if(item.GetType()==(1)){
			string radResistStr="";
			string perkStr="";
			ItemCl@equippedArmor;
			int armorNormalDTDiff=item.Proto.Armor_DTNormal,armorNormalDRDiff=item.Proto.Armor_DRNormal;
			int armorLaserDTDiff=item.Proto.Armor_DTLaser,armorLaserDRDiff=item.Proto.Armor_DRLaser;
			int armorFireDTDiff=item.Proto.Armor_DTFire,armorFireDRDiff=item.Proto.Armor_DRFire;
			int armorPlasmaDTDiff=item.Proto.Armor_DTPlasma,armorPlasmaDRDiff=item.Proto.Armor_DRPlasma;
			int armorElectrDTDiff=item.Proto.Armor_DTElectr,armorElectrDRDiff=item.Proto.Armor_DRElectr;
			int armorExplodeDTDiff=item.Proto.Armor_DTExplode,armorExplodeDRDiff=item.Proto.Armor_DRExplode;
			if(item.Proto.Slot==(3)){
				@equippedArmor=chosen.GetItem(0,(3));
			}else if(item.Proto.Slot==(((3))+1)){
				@equippedArmor=chosen.GetItem(0,(((3))+1));
			}
			if((@equippedArmor!=null)){
				armorNormalDTDiff-=equippedArmor.Proto.Armor_DTNormal;
				armorNormalDRDiff-=equippedArmor.Proto.Armor_DRNormal;
				armorLaserDTDiff-=equippedArmor.Proto.Armor_DTLaser;
				armorLaserDRDiff-=equippedArmor.Proto.Armor_DRLaser;
				armorFireDTDiff-=equippedArmor.Proto.Armor_DTFire;
				armorFireDRDiff-=equippedArmor.Proto.Armor_DRFire;
				armorPlasmaDTDiff-=equippedArmor.Proto.Armor_DTPlasma;
				armorPlasmaDRDiff-=equippedArmor.Proto.Armor_DRPlasma;
				armorElectrDTDiff-=equippedArmor.Proto.Armor_DTElectr;
				armorElectrDRDiff-=equippedArmor.Proto.Armor_DRElectr;
				armorExplodeDTDiff-=equippedArmor.Proto.Armor_DTExplode;
				armorExplodeDRDiff-=equippedArmor.Proto.Armor_DRExplode;
			}
			if(item.Proto.Armor_Perk!=0){
				if(item.Proto.Slot==(3)){
					switch(item.Proto.Armor_Perk){
						case(1):radResistStr+="+35";perkStr="\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+3 ST)";break;
						case(3):
						case(4):radResistStr+="+40";perkStr="\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+4 ST)";break;
						case(10):radResistStr+="+5";perkStr="\nLight: +1 AG \nPerk: Quick Pockets.\nPerk: Swagger. (+1 CH)";break;
						case(11):radResistStr+="+10";perkStr="\nLight: +1 AG \nPerk: Quick Pockets.";break;
						case(50):radResistStr+="+35";perkStr="\nPerk: Flame Resistant. (Higher Flamer KD resist)";break;
						case(20):radResistStr+="+25";perkStr="\nMedium: -1 AG (also AG cap 9)\nPerk: Iron Limbs.";break;
						case(30):radResistStr+="+15";perkStr="\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.";break;
						case(31):radResistStr+="+35";perkStr="\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.";break;
						case(104):radResistStr+="+10";perkStr="\nPerk: Camouflage. (Hide HP and Helm)";break;
					}
				}else if(item.Proto.Slot==(((3))+1)){
					switch(item.Proto.Armor_Perk){
						case(1):perkStr="\nPerk: Stylish. (+1 CH)";break;
						case(2):perkStr="\nPerk: Sight Correction. (PE set to 4 if lower)";break;
						case(3):perkStr="\nPerk: Protect Eyes. (Aim location Eyes changed to Head)";break;
						case(4):perkStr="\nPerk: Clear Vision. (+1 PE)";break;
						case(5):perkStr="\nPerk: Impaired Vision. (-1 PE)";break;
						case(6):perkStr="\nPerk: Camouflage. (Hide Name)";break;
						case(7):perkStr="\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-1 PE)";break;
						case(8):perkStr="\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-2 PE)";break;
					}
				}
			}
			
			text+="\nArmor Class: "+item.Proto.Armor_AC;
			text+="\nDamage resistances: (DT/DR)";
			if(item.GetProtoId()==(743)||item.GetProtoId()==(744)){
				text+="\nFront:";
			}
			
			int w=0,h=0,l=0;
			GetTextInfo(text,300,800,(5),(0x0200),w,h,l);
			inventoryTooltip.interfaceTextboxComparison.SetPosY(h+10);
			string widthText;
			text+=widthText="\n\tNormal: \u00A0\u00A0\u00A0"+item.Proto.Armor_DTNormal+"/"+item.Proto.Armor_DRNormal;
			GetTextInfo(widthText,300,800,(5),(0x0200),w,h,l);
			inventoryTooltip.interfaceTextboxComparison.SetPosX(w);
			
			if((@equippedArmor!=null)&&item.Id!=equippedArmor.Id){
				int comparisonColorDT=armorNormalDTDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorNormalDTDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				int comparisonColorDR=armorNormalDRDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorNormalDRDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				string comparisonValueDT=armorNormalDTDiff<0?(""+armorNormalDTDiff):("+"+armorNormalDTDiff);
				string comparisonValueDR=armorNormalDRDiff<0?(""+armorNormalDRDiff):("+"+armorNormalDRDiff);
				if(armorNormalDTDiff!=0||armorNormalDRDiff!=0){
					textComparison+="    \t|"+comparisonColorDT+" "+comparisonValueDT+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xAA)&0xFF)<<8)|((0)&0xFF))))+" /|"+comparisonColorDR+" "+comparisonValueDR+"\n";
				}else{
					textComparison+="\n";
				}
			}
			text+="\n\tLaser:     \u00A0"+item.Proto.Armor_DTLaser+"/"+item.Proto.Armor_DRLaser;
			if((@equippedArmor!=null)&&item.Id!=equippedArmor.Id){
				int comparisonColorDT=armorLaserDTDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorLaserDTDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				int comparisonColorDR=armorLaserDRDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorLaserDRDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				string comparisonValueDT=armorLaserDTDiff<0?(""+armorLaserDTDiff):("+"+armorLaserDTDiff);
				string comparisonValueDR=armorLaserDRDiff<0?(""+armorLaserDRDiff):("+"+armorLaserDRDiff);
				if(armorLaserDTDiff!=0||armorLaserDRDiff!=0){
					textComparison+="    \t|"+comparisonColorDT+" "+comparisonValueDT+"|"+((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xAA)&0xFF)<<8)|((0)&0xFF))))+" /|"+comparisonColorDR+" "+comparisonValueDR+"\n";
				}else{
					textComparison+="\n";
				}
			}
			text+="\n\tFire:         "+item.Proto.Armor_DTFire+"/"+item.Proto.Armor_DRFire;
			if((@equippedArmor!=null)&&item.Id!=equippedArmor.Id){
				int comparisonColorDT=armorFireDTDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorFireDTDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				int comparisonColorDR=armorFireDRDiff<0?((uint((0xFF<<24)|(((0xea)&0xFF)<<16)|(((0x46)&0xFF)<<8)|((0)&0xFF)))):(armorFireDRDiff>0?((uint((0xFF<<24)|(((0xef)&0xFF)<<16)|(((0xcf)&0xFF)<<8)|((0x30)&0xFF)))):((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xC8)&0xFF)<<8)|((0)&0xFF)))));
				string comparisonValueDT=armorFireDTDiff<0?(""+armorFireDTDiff):("+"+armorFireDTDiff);
