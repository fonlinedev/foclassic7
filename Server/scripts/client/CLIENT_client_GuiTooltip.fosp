		tooltipsValueExt.insertLast(pipReference
		+notes
		+"\n\u2022 +1 Agility bonus"
		+"\n\u2022 -1 AP cost (flat reduce) for single shots only."
		+"\n\u2022 Not possible to make aimed attacks."
		+"\n\u2022 Attacks now hit random body part:"
		+"\n\t\u2022 5% eye, 10% head, 2x10% arms, 2x10% legs, 5% groin, 20% torso, 20% unaimed"
