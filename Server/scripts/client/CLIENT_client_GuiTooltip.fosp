		+"\n\t\t\u2022 ST-4 vs 1d10 to resist weapon drop effect."
		+"\n\t\t\u2022 EN-3 vs 1d10 to resist cripple arms or legs effect."
		+"\n\t\u2022 Critical hit:"
		+"\n\t\t\u2022 (EN - 7 + 2 * Iron Limbs rank) vs 1d10 to resist cripple arms or legs effect."
		+"\n\t\t\u2022 (ST - 5 + 2 * Iron Limbs rank) vs 1d10 to resist weapon drop effect."
		+"\n\t\t\t\u2022 Note: Iron Limbs rank is 2 with combat armor perk, else only 1."
		+requirements
		+"\n\t\u2022  Endurance >= 6");
		
		tooltipsKey.insertLast((405));
		tooltipsValue.insertLast("\t\t\t"+GetMsgStr((3),(100000+((405))*10+1))+"\n\n"+GetMsgStr((3),(100000+((405))*10+2))+pipText
		+pipStatus+stonewallExt);
		tooltipsValueExt.insertLast(pipReference
		+notes
		+"\n\u2022 Gives ability to resist Knockdowns and Knockbacks."
		+"\n\t\u2022 Adds character +1 Stonewall rank and stack with Heavy Armor Perk."
		+"\n\t\u2022 Does not protect against Head/Eyes attacks KD/KO effects."
		+"\n\u2022 Knockdown resist formula: 25 + 5*(CLAMP(ST, 1, CH+5) + 20*stonewallRank vs 1d100"
		+"\n\u2022 KO that are not from Head/Eyes can be downgraded to KD instead:"
		+"\n\t\u2022 25 + 5*(CLAMP(IN, 1, CH+5) + 20*StonewallRank vs 1d100"
		+"\n\u2022 KD that are not from Head/Eyes can be protected by wearing a helmet:"
		+"\n\t\u2022 20 + 2*(CLAMP(IN, 1, CH+5) + LK vs 1d100"
		+requirements
		+"\n\t\u2022  Strength >= 6");
		
		tooltipsKey.insertLast((315));
		tooltipsValue.insertLast("\t\t\t"+GetMsgStr((3),(100000+((315))*10+1))+"\n\n"+GetMsgStr((3),(100000+((315))*10+2))+pipText);
		tooltipsValueExt.insertLast(pipReference
		+notes
		+"\n\u2022 +6 bonus to Sight Range."
		+"\n\u2022 +8% bonus to Hit Chance."
		+"\n\u2022 Allows Eye shots beyond your Perception range."
		+"\n\u2022 Reduces your targets armor critical chance modifier by 50%."
		+"\n\t\u2022 Aimed attacks only."
		+requirements
		+"\n\t\u2022  One ranged combat skill or Close Combat >= 100"
		+"\n\t\u2022  Perception >= 7"
		+"\n\t\u2022  Intellect >= 3");
		
		tooltipsKey.insertLast((305));
		tooltipsValue.insertLast("\t\t\t"+GetMsgStr((3),(100000+((305))*10+1))+"\n\n"+GetMsgStr((3),(100000+((305))*10+2))+pipText);
		tooltipsValueExt.insertLast(pipReference
		+notes
		+"\n\u2022 +3 bonus damage per bullet with Guns."
		+"\n\t\u2022 Works with energy weapons as well, despite the term 'per bullet'."
		+"\n\u2022 Mutually exclusive with Bonus Ranged Damage."
		+requirements
		+"\n\t\u2022  One ranged combat skill >= 100");
		
		tooltipsKey.insertLast((428));
		tooltipsValue.insertLast("\t\t\t"+GetMsgStr((3),(100000+((428))*10+1))+"\n\n"+GetMsgStr((3),(100000+((428))*10+2))+pipText);
		tooltipsValueExt.insertLast(pipReference
		+notes
		+"\n\u2022 Up to +5 bonus damage per bullet based on your and your targets Charisma:"
		+"\n\t\u2022 CLAMP(attacker.CH - ((target.CH2 + 1)*2/3), 0, 6) + 1"
		+"\n\t\u2022 ex: attacker.CH=5, target.CH=3 -> +3 damage per bullet"
		+"\n\t\u2022 ex: attacker.CH=7, target.CH=4 -> +5 damage per bullet"
		+"\n\u2022 Mutually exclusive with Bonus Ranged Damage."
		+"\n\u2022 Later also known or referenced as Confident Shooter."
		+requirements
		+"\n\t\u2022  One ranged combat skill >= 100"
		+"\n\t\u2022 Charisma >= 4");
		
