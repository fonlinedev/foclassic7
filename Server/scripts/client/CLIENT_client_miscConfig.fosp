void CMiscConfigLog(string@s){
	Log("Config :: "+s);
	if((false)){
		Message("Config :: "+s);
	}
}

CMiscConfig miscConfig;

CMiscConfig@getMiscConfig(){
	return miscConfig;
} 

void MiscConfig(string&customConfig){
	CMiscConfigLog("MiscConfig = "+customConfig);
	string sectioname=(customConfig==""?"Misc":"Misc"+":"+customConfig);
	IConfigSection@section=GetConfigSection("Reloaded.cfg",sectioname);
	CMiscConfigLog("section = "+sectioname);
	
	if((@section!=null)){
		string@val;
		
		@val=GetConfigValue("Reloaded.cfg",sectioname,"PingTresholdYellow");
		if((@val!=null)&&val.length()>0){
			miscConfig.PingTresholdYellow=(((string2uint(val))>(1000))?(1000):(((string2uint(val))<(0))?(0):(string2uint(val))));
			CMiscConfigLog("PingTresholdYellow = "+miscConfig.PingTresholdYellow+" ("+val+")");
		}else{
			CMiscConfigLog("PingTresholdYellow invalid or missing");
		}
		
		@val=GetConfigValue("Reloaded.cfg",sectioname,"PingTresholdOrange");
		if((@val!=null)&&val.length()>0){
			miscConfig.PingTresholdOrange=(((string2uint(val))>(1000))?(1000):(((string2uint(val))<(0))?(0):(string2uint(val))));
			CMiscConfigLog("PingTresholdOrange = "+miscConfig.PingTresholdOrange+" ("+val+")");
		}else{
			CMiscConfigLog("PingTresholdOrange invalid or missing");
		}
		
		@val=GetConfigValue("Reloaded.cfg",sectioname,"FpsTresholdYellow");
		if((@val!=null)&&val.length()>0){
			miscConfig.FpsTresholdYellow=(((string2uint(val))>(500))?(500):(((string2uint(val))<(0))?(0):(string2uint(val))));
			CMiscConfigLog("FpsTresholdYellow = "+miscConfig.FpsTresholdYellow+" ("+val+")");
		}else{
			CMiscConfigLog("FpsTresholdYellow invalid or missing");
		}
		
		@val=GetConfigValue("Reloaded.cfg",sectioname,"FpsTresholdOrange");
		if((@val!=null)&&val.length()>0){
			miscConfig.FpsTresholdOrange=(((string2uint(val))>(500))?(500):(((string2uint(val))<(0))?(0):(string2uint(val))));
			CMiscConfigLog("FpsTresholdOrange = "+miscConfig.FpsTresholdOrange+" ("+val+")");
		}else{
			CMiscConfigLog("FpsTresholdOrange invalid or missing");
		}
	}
} 

