int GetSmartItemMoveCount(ItemCl&item){
	int ret=5;
	CritterCl@chosen=GetChosen();
	if(!(@chosen!=null)){
		return 0;
	}
	if(!(@item!=null)){
		return 0;
	}
	
	switch(item.GetProtoId()){
		
		case(525):
		case(273):
		case(40):
		case(144):
		ret=smartLoot.HealingDrugs;
		break;
		
		case(109):
		case(53):
		case(87):
		ret=smartLoot.Drugs;
		break;
		case(106):
		ret=smartLoot.NukaCola;
		break;
		case(541):
		ret=smartLoot.Cigarettes;
		break;
		case(110):
		ret=smartLoot.Psycho;
		break;
		case(259):
		ret=smartLoot.Jet;
		break;
		case(260):
		ret=smartLoot.JetAntidote;
		break;
		case(49):
		ret=smartLoot.Antidote;
		break;
		case(48):
		ret=smartLoot.RadAway;
		break;
		
		case(26762):
		case(26761):
		case(26760):
		ret=smartLoot.Fish;
		break;
		
		case(125):
		case(124):
		case(311):
		case(310):
		case(469):
		ret=smartLoot.Alcohol;
		break;
		
		case(26):
		case(25):
		case(626):
		case(159):
		case(27):
		ret=smartLoot.Grenades;
		break;
		
		case(79):
		case(9721):
		case(9723):
		case(9725):
		ret=smartLoot.Flares;
		break;
		case(14):
		case(37):
		case(621):
		ret=smartLoot.Rockets;
		break;
		
		case(19):
		case(45):
		case(584):
		case(573):
		case(365):
		case(7):
		case(280):
		case(320):
		ret=smartLoot.OtherThrown;
		break;
		
		case(9850):
		ret=smartLoot.Traps;
		break; 
		
		case(38):
		ret=smartLoot.MagMultiplier*60;
		break;
		
		case(39):
		ret=smartLoot.MagMultiplier*30;
		break;
		
		case(95):
		case(576):
		case(574):
		case(575):
		case(850):
		ret=smartLoot.MagMultiplier*20;
		break;
		
		case(32):
		case(382):
		ret=smartLoot.MagMultiplier*5;
		break;
		
		case(361):
		case(362):
		ret=smartLoot.MagMultiplier*10;
		break;
		
		case(163):
		ret=smartLoot.MagMultiplier*100;
		break;
		
		case(358):
		ret=smartLoot.MagMultiplier*20;
		break;
		
		case(34):
		ret=smartLoot.MagMultiplier*30;
		break;
		
		case(111):
		case(31):
		ret=smartLoot.MagMultiplier*10;
		break;
		
		case(357):
		ret=smartLoot.MagMultiplier*75;
		break;
		
		case(359):
		ret=smartLoot.MagMultiplier*100;
		break;
		
		case(36):
		case(35):
		ret=smartLoot.MagMultiplier*120;
		break;
		
		case(363):
		ret=smartLoot.MagMultiplier*100;
		break;
		
		case(360):
		case(121):
		ret=smartLoot.MagMultiplier*7;
		break;
		
		case(30):
		case(29):
		ret=smartLoot.MagMultiplier*60;
		break;
		
		case(33):
		ret=smartLoot.MagMultiplier*10;
		break;
	}
	return ret;
}  

