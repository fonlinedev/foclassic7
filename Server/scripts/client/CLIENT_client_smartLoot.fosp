void SmartLootLog(string@s){
	Log("SmartLoot :: "+s);
	if((false)){
		Message("SmartLoot :: "+s);
	}
}

class CSmartLoot{
	
	int DefaultValue=5;
	
	int Caps=5000;
	
	int MagMultiplier=3;
	int Grenades=5;
	int Flares=5;
	int OtherThrown=20;
	int Rockets=20;
	int Traps=5;
	
	int Drugs=2;
	int Psycho=2;
	int Jet=2;
	int JetAntidote=2;
	int Antidote=3;
	int RadAway=3;
	int Fish=5;
	int Alcohol=2;
	int NukaCola=5;
	int Cigarettes=5;
	int MutatedFruit=10;
	int HealingDrugs=5;
	
	CSmartLoot(){
	}
};

CSmartLoot smartLoot;

void SmartLootConfig(string&customConfig){
	SmartLootLog("SmartLootConfig = "+customConfig);
	string sectioname=(customConfig==""?"SmartLoot":"SmartLoot"+":"+customConfig);
	IConfigSection@section=GetConfigSection("Reloaded.cfg",sectioname);
	SmartLootLog("section = "+sectioname);
	
	if((@section!=null)){
		string@val;
		
		@val=GetConfigValue("Reloaded.cfg",sectioname,"Caps");
		if((@val!=null)&&val.length()>0){
			smartLoot.Caps=(((string2uint(val))>((1000000)))?((1000000)):(((string2uint(val))<(0))?(0):(string2uint(val))));
			SmartLootLog("Caps = "+smartLoot.Caps+" ("+val+")");
		}else{
			SmartLootLog("Caps invalid or missing");
		}
		
