class CInterfaceControl:IInterfaceControl{
	
	int posX,posY;
	int width,height,minWidth,maxWidth,minHeight,maxHeight;
	int mouseX,mouseY;
	bool visible,active,locked,moveable,resizeable;
	uint alignment;
	
	CInterfaceControl(){
		posX=0;
		posY=0;
		width=0;
		height=0;
		minWidth=5;
		maxWidth=800;
		minHeight=5;
		maxHeight=600;
		visible=true;
		active=true;
		locked=false;
		moveable=true;
		resizeable=true;
		alignment=0;
	}
	
	void Init(){
	}
	
	void Draw(int offsetX,int offsetY,int maxWidth,int maxHeight){
		Message("draw IC");
	}
	
	void Update(){
	}
	
	void Move(int x,int y){
		if(0<=posX+x&&posX+x+width<=__ScreenWidth){
			posX+=x;
		}
		if(0<=posY+y&&posY+y+width<=__ScreenHeight){
			posY+=y;
		}
	}
	void SetPosX(int x){
		if(0<=posX&&posX<=__ScreenWidth){
			posX=x;
		}
	}
	void SetPosY(int y){
		if(0<=posY&&posY<=__ScreenHeight){
			posY=y;
		}
	}
	void SetWidth(int w){
		if(minWidth<=w&&w<=maxWidth){
			width=w;
		}
	}
	void SetHeight(int h){
		if(minHeight<=h&&h<=maxHeight){
			height=h;
		}
	}
	
	bool MouseDown(int x,int y,int click){
		return false;
	}
	
	bool MouseUp(int x,int y,int click){
		return false;
	}
	
	bool MouseMove(int fromX,int fromY,int toX,int toY){
		return false;
	}
	
	bool KeyDown(uint8 key){
		return false;
	}
	
	bool KeyUp(uint8 key){
		return false;
	}
	
	uint loadByIni(string&iniKey,int path)
	{
		string@name=GetIfaceIniStr(iniKey);
		uint id;
		if(@name!=null&&name.length()>0)
		id=LoadSprite(name,path);
		else
		id=0;
		return id;
	}
	
	uint getAlignment(){
		return alignment;
	}
	
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                

class CInterfaceTextbox:CInterfaceControl{
	
	bool hasBackground;
	uint backgroundColor,textColor;
	array<string>lines;
	string text;
	uint currentLineToDrawIndex,lastLineToDrawIndex;
	int textFont;
	int oneLineHeight; 
	
	CInterfaceTextbox(int x,int y,int w,int h){
		posX=x;
		posY=y;
		width=w;
		height=h;
		hasBackground=false;
		textFont=(5);
	}
	
	int setText(string oneLineText){
		int w=0,h=0,l=0;
		GetTextInfo(oneLineText,width,height,textFont,0,w,h,l);
		text=oneLineText; 
		
		return h;
	}
	
	void Init(){
		currentLineToDrawIndex=0;
		lastLineToDrawIndex=0;
		backgroundColor=(uint((((150)&0xFF)<<24)|(((0)&0xFF)<<16)|(((0)&0xFF)<<8)|((0)&0xFF)));
		textColor=((uint((0xFF<<24)|(((0)&0xFF)<<16)|(((0xAA)&0xFF)<<8)|((0)&0xFF))));
		int w=0,h=0,l=0;
		GetTextInfo("OneLineHeight",width,height,textFont,0,w,h,l);
		oneLineHeight=h;
	}
	
	void SetFont(int font){
		textFont=font;
	}
	
	void SetLines(array<string>lines_){
		lines=lines_;
	}
	
	void AddLine(string line){
		lines.insertLast(line);
	}
	
	void Draw(int offsetX,int offsetY,int maxWidth,int maxHeight){ 
		
		drawText(offsetX,offsetY);
	}
	
	void Draw(){
		
		Draw(100,100);
	}
	
	void Draw(int offsetX,int offsetY){
		drawBackground(offsetX,offsetY);
		
		drawTextByLine(offsetX,offsetY);
		
	}
	
	void drawBackground(int offsetX,int offsetY){
		if(hasBackground){
			int x=posX+offsetX;
			int y=posY+offsetY;
			array<int>background;
			int bcolor=int(backgroundColor);
			
			background.insertLast(x);
			background.insertLast(y);
			background.insertLast(bcolor); 
			
			background.insertLast(x+width);
			background.insertLast(y);
			background.insertLast(bcolor); 
			
			background.insertLast(x+width);
			background.insertLast(y+height);
			background.insertLast(bcolor); 
			
			background.insertLast(x);
			background.insertLast(y+height);
			background.insertLast(bcolor);
			
			DrawPrimitive((6),background);
		}
	}
	
	void drawText(int offsetX,int offsetY){
		int x=offsetX+posX;
		int y=offsetY+posY;
		DrawText(text,x,y,width,height,textColor,textFont,0);
	}
	
	void drawTextByLine(int offsetX,int offsetY){
		int x=offsetX+posX;
		int y=offsetY+posY;
		DrawText(text,x,y,width,height,textColor,textFont,0);
	}
	
	void Update(){
		text="";
		updateLastDrawableLine();
		for(uint i=currentLineToDrawIndex;i<lines.length();i++){
			text+=lines[i]+"\n";
		}
		int w=0,h=0,l=0;
		GetTextInfo(text,width,height,textFont,0,w,h,l);
		
	}
	
	void updateLastDrawableLine(){
		int w=0,h=0,l=0,currentHeight=height;
		uint index=lines.length()-1;
		if(index<=0){
			lastLineToDrawIndex=0;
		}else{
			bool found=false;
			while(!found){
				GetTextInfo(lines[index],width,height,textFont,0,w,h,l);
				currentHeight-=h+1;
				
				if(currentHeight<=oneLineHeight||index<=0){
					found=true;
					lastLineToDrawIndex=index;
				}
				if(currentHeight<0){
					lastLineToDrawIndex=index+1;
				}
				index--;
			}
		}
	}
	
	void MouseWheelDown(){
		if(currentLineToDrawIndex<lastLineToDrawIndex){
			currentLineToDrawIndex++;
			Update();
		}
	}
	
	void MouseWheelUp(){
		if(currentLineToDrawIndex>0){
			currentLineToDrawIndex--;
			Update();
		}
	}
	
	void SetWidth(int w)override{
		CInterfaceControl::SetWidth(w);
		Update();
	}
	
	void SetHeight(int h)override{
		CInterfaceControl::SetHeight(h);
		Update();
	}
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             

class CInterfaceWindow{ 
	
	bool allowResize,allowMove;
	int posX,posY;
	int totalWidth,totalHeight;
	int borderSizeLeft,borderSizeRight,borderSizeTop,borderSizeBottom;
	int minWidth,maxWidth,minHeight,maxHeight;
	private int minPosX,maxPosX,minPosY,maxPosY;
	private uint topLeftCornerImageH,topElementImage,topRightCornerImageH;
	private uint topRightCornerImageV,rightElementImage,bottomRightCornerImageV;
	private uint topLeftCornerImageV,leftElementImage,bottomLeftCornerImageV;
	private uint bottomLeftCornerImageH,bottomElementImage,bottomRightCornerImageH;
	private uint topLeftCornerResize,topRightCornerResize,bottomRightCornerResize,bottomLeftCornerResize;
	private int drawInfoOffsetX,drawInfoOffsetY,drawInfoFont,drawInfoFlags;
	private uint drawInfoColor;  
	
	private bool moveWithMouse;
	private bool resizeWithMouseTop,resizeWithMouseRight,resizeWithMouseLeft,resizeWithMouseBottom;
	private bool resizeWithMouseTopLeftCorner,resizeWithMouseTopRightCorner,resizeWithMouseBottomLeftCorner,resizeWithMouseBottomRightCorner; 
	
	bool locked;
	bool hasBackground;
	uint backgroundColor; 
	
	array<CInterfaceControl@>childControls;  
	
	string infoText;
	
	CInterfaceWindow(int posX_,int posY_,int totalWidth_,int totalHeight_,int maxWidth_=800,int maxHeight_=600){
		posX=posX_;
		posY=posY_;
		totalWidth=totalWidth_;
		totalHeight=totalHeight_;
		borderSizeLeft=5;
		borderSizeRight=5;
		borderSizeTop=5;
		borderSizeBottom=5;
		minWidth=10;
		maxWidth=maxWidth_>totalWidth_?maxWidth_:totalWidth_;
		minHeight=10;
		maxHeight=maxHeight_>totalHeight_?maxHeight_:totalHeight_;
		minPosX=0;
		minPosY=0;
		moveWithMouse=false;
		resizeWithMouseTopLeftCorner=false;
		resizeWithMouseTopRightCorner=false;
		resizeWithMouseBottomLeftCorner=false;
		resizeWithMouseBottomRightCorner=false;
		resizeWithMouseTop=false;
		resizeWithMouseRight=false;
		resizeWithMouseLeft=false;
		resizeWithMouseBottom=false;
		locked=false;
		hasBackground=true;
		backgroundColor=(uint((((150)&0xFF)<<24)|(((0)&0xFF)<<16)|(((0)&0xFF)<<8)|((0)&0xFF)));
		drawInfoColor=(uint((((255)&0xFF)<<24)|(((0)&0xFF)<<16)|(((255)&0xFF)<<8)|((0)&0xFF)));
		drawInfoOffsetX=7;
		drawInfoOffsetY=-12;
		drawInfoFont=(5);
		drawInfoFlags=(0x0200);
		infoText="";
		allowResize=true;
		allowMove=true;
		Init();
	}
	
	CInterfaceWindow(){
		CInterfaceWindow(0,0,10,10);
	}
	
	void Init(){ 
		
		topLeftCornerImageH=loadByIni("CWindowTopLeftCornerH",(4));
		topElementImage=loadByIni("CWindowTopElement",(4));
		topRightCornerImageH=loadByIni("CWindowTopRightCornerH",(4));
		borderSizeTop=GetSpriteHeight(topElementImage,0);
		
		topRightCornerImageV=loadByIni("CWindowTopRightCornerV",(4));
		rightElementImage=loadByIni("CWindowRightElement",(4));
		bottomRightCornerImageV=loadByIni("CWindowBottomRightCornerV",(4));
		borderSizeRight=GetSpriteWidth(rightElementImage,0);
		
		topLeftCornerImageV=loadByIni("CWindowTopLeftCornerV",(4));
		leftElementImage=loadByIni("CWindowLeftElement",(4));
		bottomLeftCornerImageV=loadByIni("CWindowBottomLeftCornerV",(4));
		borderSizeLeft=GetSpriteWidth(leftElementImage,0);
		
		bottomLeftCornerImageH=loadByIni("CWindowBottomLeftCornerH",(4));
		bottomElementImage=loadByIni("CWindowBottomElement",(4));
		bottomRightCornerImageH=loadByIni("CWindowBottomRightCornerH",(4));
		borderSizeBottom=GetSpriteHeight(bottomElementImage,0);
		
		topLeftCornerResize=loadByIni("CWindowTopLeftCornerRed",(4));
		topRightCornerResize=loadByIni("CWindowTopRightCornerRed",(4));
		bottomRightCornerResize=loadByIni("CWindowBottomRightCornerRed",(4));
		bottomLeftCornerResize=loadByIni("CWindowBottomLeftCornerRed",(4));
		
		minWidth=GetSpriteWidth(topLeftCornerImageH,0)+GetSpriteWidth(topRightCornerImageH,0);
		minHeight=GetSpriteHeight(topLeftCornerImageV,0)+GetSpriteHeight(bottomLeftCornerImageV,0);   
		
	}
	
	void enableMove(){
		if(!locked){
			moveWithMouse=true;
		}
	}
	
	void disableMove(){
		moveWithMouse=false;
	}
	
	void AddInterfaceControl(CInterfaceControl control){
		childControls.insertLast(control);
	}
	
	void SetTextbox(CInterfaceTextbox textBox_){
		
	}
	
	void SetFont(int font){
		drawInfoFont=font;
	}
	
	void FitScreen(){
		if(posX+totalWidth>__ScreenWidth){
			posX=__ScreenWidth-totalWidth;
		}
		if(posX<0){
			posX=0;
		}
		if(posY+totalHeight>__ScreenHeight){
			posY=__ScreenHeight-totalHeight;
		}
		if(posY<0){
			posY=0;
		}
	}
	
	void FitScreen(int left,int right,int top,int bottom,bool leftFirst){
		if(posY+totalHeight>__ScreenHeight){
			posY=__ScreenHeight-totalHeight;
		}
		if(posY<0){
			posY=0;
		}
		if(leftFirst){
			if(left-totalWidth-10>0){
				posX=left-totalWidth-10;
			}else{
				posX=right+10;
				if(posX+totalWidth>__ScreenWidth){
					posX=__ScreenWidth-totalWidth;
				}
			}
		}else{
			if(right+totalWidth+10<__ScreenWidth){
				posX=right+10;
			}else{
				posX=left-totalWidth-10;
				if(posX<0){
					posX=0;
				}
			}
		}
	}
	
	bool CatchMouseClick(int click){
		if(GetCurrentCursor()==(0)&&click==(4)){
			if(isWithinDrawArea(__MouseX,__MouseY)){
				
				return true;
			}
		}
		if(GetCurrentCursor()==(0)&&click==(3)){
			if(isWithinDrawArea(__MouseX,__MouseY)){
				
				return true;
			}
		}
		if(GetCurrentCursor()==(0)&&click==(2)){
			if(isWithinDrawArea(__MouseX,__MouseY)){
				locked=!locked;
				return true;
			}
		}
		if(GetCurrentCursor()==(0)&&click==(0)){
			CritterCl@chosen=GetChosen();
			if((@chosen!=null)){
				if(isOnTopLeftCornerDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseTopLeftCorner=true;
					
					return true;
				}
				if(isOnTopRightCornerDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseTopRightCorner=true;
					
					return true;
				}
				if(isOnBottomRightCornerDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseBottomRightCorner=true;
					
					return true;
				}
				if(isOnBottomLeftCornerDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseBottomLeftCorner=true;
					
					return true;
				}
				if(isOnTopBorderDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseTop=true;
					
					return true;
				}
				if(isOnRightBorderDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseRight=true;
					
					return true;
				}
				if(isOnLeftBorderDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseLeft=true;
					
					return true;
				}
				if(isOnBottomBorderDrawArea(__MouseX,__MouseY)&&allowResize){
					resizeWithMouseBottom=true;
					
					return true;
				}
				if(isWithinDrawArea(__MouseX,__MouseY)){
					moveWithMouse=true;
					
					return true;
				}
				return false;
			}else{
				return false;
			}
		}else{
			return false;
		}
	}
	
	bool CatchMouseRelease(){
		infoText="";
		moveWithMouse=false;
		resizeWithMouseTopLeftCorner=false;
		resizeWithMouseTopRightCorner=false;
		resizeWithMouseBottomLeftCorner=false;
		resizeWithMouseBottomRightCorner=false;
		resizeWithMouseTop=false;
		resizeWithMouseRight=false;
		resizeWithMouseLeft=false;
		resizeWithMouseBottom=false;
		return true;
	}
	
	bool UpdateMousePositionChange(int x,int y){
		if(!locked){
			if(moveWithMouse){
				move(x,y);
				infoText="Pos ("+posX+", "+posY+")";
				
				return true;
			}else{
				if(resizeWithMouseTopLeftCorner){
					resizeTop(y);
					resizeLeft(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseTopRightCorner){
					resizeTop(y);
					resizeRight(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseBottomRightCorner){
					resizeBottom(y);
					resizeRight(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseBottomLeftCorner){
					resizeBottom(y);
					resizeLeft(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseTop){
					resizeTop(y);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseRight){
					resizeRight(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseLeft){
					resizeLeft(x);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				if(resizeWithMouseBottom){
					resizeBottom(y);
					infoText="Size ("+totalWidth+", "+totalHeight+")";
					return true;
				}
				return false;
			}
		}else{
			return false;
		}
	}
	
	bool isWithinDrawArea(int x,int y){
		if(x>=posX&&x<=posX+totalWidth&&
		y>=posY&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnTopLeftCornerDrawArea(int x,int y){
		if(x>=posX&&x<=posX+borderSizeLeft*2&&
		y>=posY&&y<=posY+borderSizeTop*2){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnTopRightCornerDrawArea(int x,int y){
		if(x>=posX+totalWidth-borderSizeRight*2&&x<=posX+totalWidth&&
		y>=posY&&y<=posY+borderSizeTop*2){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnBottomRightCornerDrawArea(int x,int y){
		if(x>=posX+totalWidth-borderSizeRight*2&&x<=posX+totalWidth&&
		y>=posY+totalHeight-borderSizeBottom*2&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnBottomLeftCornerDrawArea(int x,int y){
		if(x>=posX&&x<=posX+borderSizeLeft*2&&
		y>=posY+totalHeight-borderSizeBottom*2&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	} 
	
	private bool isOnTopBorderDrawArea(int x,int y){
		if(x>=posX&&x<=posX+totalWidth&&
		y>=posY&&y<=posY+borderSizeTop){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnRightBorderDrawArea(int x,int y){
		if(x>=posX+totalWidth-borderSizeRight&&x<=posX+totalWidth&&
		y>=posY&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnLeftBorderDrawArea(int x,int y){
		if(x>=posX&&x<=posX+borderSizeLeft&&
		y>=posY&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	}
	
	private bool isOnBottomBorderDrawArea(int x,int y){
		if(x>=posX&&x<=posX+totalWidth&&
		y>=posY+totalHeight-borderSizeBottom&&y<=posY+totalHeight){
			return true;
		}else{
			return false;
		}
	}
	
	private uint loadByIni(string&iniKey,int path)
	{
		string@name=GetIfaceIniStr(iniKey);
		uint id;
		if(@name!=null&&name.length()>0){
			id=LoadSprite(name,path);
			
		}else{
			id=0;
			Log("Failed to log sprite:"+iniKey);
		}
		return id;
	}
	
	void DrawWindow(){
		drawBackground();
		drawChildControls();
		drawTopBorder();
		drawRightBorder();
		drawLeftBorder();
		drawBottomBorder();
		drawResizeBorders();
		drawInfoText();
	}
	
	void drawInfoText(){
		
		DrawText(infoText,__MouseX+this.drawInfoOffsetX,__MouseY+this.drawInfoOffsetY,0,0,this.drawInfoColor,this.drawInfoFont,this.drawInfoFlags);
	}
	
	private void drawChildControls(){
		for(uint i=0;i<childControls.length();i++){ 
			
			childControls[i].Draw(posX,posY,totalWidth,totalHeight);
		}
	}
	
	private void drawTopBorder(){
		int step=getElementPosShift(GetSpriteWidth(topElementImage,0),totalWidth);
		int elementStep=GetSpriteWidth(topElementImage,0);
		int nrOfSteps=totalWidth/elementStep;
		DrawSprite(topLeftCornerImageH,-1,posX,posY,0);
		DrawSprite(topRightCornerImageH,-1,posX+totalWidth-GetSpriteWidth(topRightCornerImageH,0),posY,0);
		for(int i=0;i<nrOfSteps;i++){
			DrawSprite(topElementImage,-1,posX+step,posY,0);
			step+=elementStep;
		}
	}
	
	private void drawRightBorder(){
		int step=getElementPosShift(GetSpriteHeight(rightElementImage,0),totalHeight);
		int elementStep=GetSpriteHeight(rightElementImage,0);
		int nrOfSteps=totalHeight/elementStep;
		for(int i=0;i<nrOfSteps;i++){
			DrawSprite(rightElementImage,-1,posX+totalWidth-GetSpriteWidth(rightElementImage,0),posY+step,0);
			step+=elementStep;
		}
		DrawSprite(topRightCornerImageV,-1,posX+totalWidth-GetSpriteWidth(topRightCornerImageV,0),posY,0);
		DrawSprite(bottomRightCornerImageV,-1,posX+totalWidth-GetSpriteWidth(bottomRightCornerImageV,0),
		posY+totalHeight-GetSpriteHeight(bottomRightCornerImageV,0),0);
	}
	
	private void drawLeftBorder(){
		int step=getElementPosShift(GetSpriteHeight(leftElementImage,0),totalHeight);
		int elementStep=GetSpriteHeight(leftElementImage,0);
		int nrOfSteps=totalHeight/elementStep;
		for(int i=0;i<nrOfSteps;i++){
			DrawSprite(leftElementImage,-1,posX,posY+step,0);
			step+=elementStep;
		}
		DrawSprite(topLeftCornerImageV,-1,posX,posY,0);
		DrawSprite(bottomLeftCornerImageV,-1,posX,
		posY+totalHeight-GetSpriteHeight(bottomLeftCornerImageV,0),0);
	}
	
	private void drawBottomBorder(){
		int step=getElementPosShift(GetSpriteWidth(bottomElementImage,0),totalWidth);
		int elementStep=GetSpriteWidth(bottomElementImage,0);
		int nrOfSteps=totalWidth/elementStep;
		DrawSprite(bottomLeftCornerImageH,-1,posX,
		posY+totalHeight-GetSpriteHeight(bottomLeftCornerImageH,0),0);
		DrawSprite(bottomRightCornerImageH,-1,posX+totalWidth-GetSpriteWidth(bottomRightCornerImageH,0),
		posY+totalHeight-GetSpriteHeight(bottomRightCornerImageH,0),0);
		for(int i=0;i<nrOfSteps;i++){
			DrawSprite(bottomElementImage,-1,posX+step,
			posY+totalHeight-GetSpriteHeight(bottomElementImage,0),0);
			step+=elementStep;
		}
	}
	
	private void drawResizeBorders(){
		if(resizeWithMouseTopLeftCorner||resizeWithMouseTop||resizeWithMouseLeft){
			DrawSprite(topLeftCornerResize,-1,posX,posY,0);
		}
		if(resizeWithMouseTopRightCorner||resizeWithMouseTop||resizeWithMouseRight){
			DrawSprite(topRightCornerResize,-1,posX+totalWidth-GetSpriteWidth(topRightCornerResize,0),posY,0);
		}
		if(resizeWithMouseBottomRightCorner||resizeWithMouseBottom||resizeWithMouseRight){
			DrawSprite(bottomRightCornerResize,-1,posX+totalWidth-GetSpriteWidth(bottomRightCornerResize,0),posY+totalHeight-GetSpriteHeight(bottomRightCornerResize,0),0);
		}
		if(resizeWithMouseBottomLeftCorner||resizeWithMouseBottom||resizeWithMouseLeft){
			DrawSprite(bottomLeftCornerResize,-1,posX,posY+totalHeight-GetSpriteHeight(bottomLeftCornerResize,0),0);
		}
	}
	
	private void drawBackground(){
		if(hasBackground){
			
			array<int>background;
			int bcolor=int(backgroundColor);
			
			background.insertLast(posX);
			background.insertLast(posY);
			background.insertLast(bcolor); 
			
			background.insertLast(posX+totalWidth);
			background.insertLast(posY);
			background.insertLast(bcolor); 
			
			background.insertLast(posX+totalWidth);
			background.insertLast(posY+totalHeight);
			background.insertLast(bcolor); 
			
			background.insertLast(posX);
			background.insertLast(posY+totalHeight);
			background.insertLast(bcolor);
			
			DrawPrimitive((6),background);
		}else{
			Message("No background.");
		}
	}
	
	private int getElementPosShift(int elementLenght_,int totalLenght_){
		int remainder=(totalLenght_%elementLenght_);
		return remainder/2;
	}
	
	private void move(int x,int y){
		if(0<=posX+x&&posX+x+totalWidth<=__ScreenWidth){
			posX+=x;
		}
		if(0<=posY+y&&posY+y+totalHeight<=__ScreenHeight){
			posY+=y;
		}
	}
	
	private void resizeTop(int y){
		if(minHeight<=totalHeight-y&&totalHeight-y<=maxHeight){
			posY+=y;
			setTotalHeight(totalHeight-y);
			
		}
	}
	private void resizeRight(int x){
		setTotalWidth(totalWidth+x);
		
	}
	
	private void resizeLeft(int x){
		if(minWidth<=totalWidth-x&&totalWidth-x<=maxWidth){
			posX+=x;
			setTotalWidth(totalWidth-x);
			
		}
	}
	
	private void resizeBottom(int y){
		setTotalHeight(totalHeight+y);
		
	}
	
	private void setPosX(int x){
		posX=x;
	}
	private void setPosY(int y){
		posY=y;
	}
	private void setTotalWidth(int w){
		if(minWidth<=w&&w<=maxWidth){
			totalWidth=w;
		}
	}
	private void setTotalHeight(int h){
		if(minHeight<=h&&h<=maxHeight){
			totalHeight=h;
		}
	}
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                

class CInterfaceImage:CInterfaceControl{
	
	bool hasBackground;
	uint backgroundColor;
	uint imageSprite=0;
	int spriteWidth;
	int spriteHeight;
	float ratio;
	bool canResize; 
	
	CInterfaceImage(int x,int y,int w,int h){
		posX=x;
		posY=y;
		width=w;
		height=h;
		hasBackground=false;
	}
	
	void Init(){
		backgroundColor=(uint((((150)&0xFF)<<24)|(((0)&0xFF)<<16)|(((0)&0xFF)<<8)|((0)&0xFF)));
		int w=0,h=0,l=0;
	}
	
	bool SetImage(string&imageName){
		imageSprite=LoadSprite(imageName,(4));
		if(imageSprite>0){
			spriteWidth=GetSpriteWidth(imageSprite,-1);
			spriteHeight=GetSpriteHeight(imageSprite,-1);
			ratio=float(spriteWidth)/spriteHeight;
			return true;
		}else{
			return false;
		}
	}
	
	void Draw(int offsetX,int offsetY,int maxW,int maxH){
		if(imageSprite>0){
			int x=posX+offsetX;
			int y=posY+offsetY;         
			
			int drawWidth=maxW-posX;
			int drawHeight=maxH-posY;
			
			int drawWidthAligned=drawWidth;
			int drawHeightAligned=drawHeight; 
			
			if(drawWidth>int(drawHeight*ratio)){
				drawWidthAligned=int(drawHeight*ratio);
			}else if(drawHeight>int(float(drawWidth)/ratio)){
				drawHeightAligned=int(float(drawWidth)/ratio);
			}
			if(drawWidth>drawWidthAligned){
				x+=(drawWidth-drawWidthAligned)/2;
			}
			if(drawHeight>drawHeightAligned){
				y+=(drawHeight-drawHeightAligned)/2;
			}
			
			drawBackground(x,y);
			
			DrawSprite(imageSprite,-1,x,y,drawWidthAligned,drawHeightAligned,false,false,0); 
			
		}
	}
	
	void drawBackground(int offsetX,int offsetY){
		
		if(hasBackground){
			int x=posX+offsetX;
			int y=posY+offsetY;
			array<int>background;
			int bcolor=int(backgroundColor); 
			
			background.insertLast(x);
			background.insertLast(y);
			background.insertLast(bcolor); 
			
			background.insertLast(x+width);
			background.insertLast(y);
			background.insertLast(bcolor); 
			
			background.insertLast(x+width);
			background.insertLast(y+height);
			background.insertLast(bcolor); 
			
			background.insertLast(x);
			background.insertLast(y+height);
			background.insertLast(bcolor);
			
			DrawPrimitive((6),background);
		}
	}
	
	void SetWidth(int w)override{
		CInterfaceControl::SetWidth(w);
	}
	
	void SetHeight(int h)override{
		CInterfaceControl::SetHeight(h);
	}
}     

CGuiImage guiImage;
CInterfaceWindow interfaceWindow;
CInterfaceImage interfaceImage; 

void ToggleGuiImage(){
	guiImage.enabled=!guiImage.enabled;
} 

bool IsGuiImageEnabled(){
	return guiImage.enabled;
} 

void InitGuiImage(){
	Log("InitGuiImage()");
	
	guiImage=CGuiImage();
	interfaceWindow=CInterfaceWindow(0,0,700,405);
	interfaceWindow.maxWidth=__ScreenWidth*4/5;
	interfaceWindow.maxHeight=__ScreenHeight*4/5;
	interfaceImage=CInterfaceImage(0,0,1400,810);
	interfaceImage.hasBackground=false;        
	
	interfaceWindow.childControls.insertLast(interfaceImage);
} 

bool SetImage(string&imageFile,bool limitWindowSizeMaxToImageSize,bool resizeEnabled,bool moveEnabled){
	if(interfaceImage.SetImage(imageFile)){
		Log("Setting image: "+imageFile);
		
		interfaceWindow.allowResize=resizeEnabled;
		interfaceWindow.allowMove=moveEnabled;
		interfaceWindow.totalWidth=interfaceImage.spriteWidth+interfaceWindow.borderSizeLeft+interfaceWindow.borderSizeRight;
		interfaceWindow.totalHeight=interfaceImage.spriteHeight+interfaceWindow.borderSizeTop+interfaceWindow.borderSizeBottom;
		interfaceWindow.posX=(__ScreenWidth-interfaceWindow.totalWidth)/2;
		interfaceWindow.posY=10;
		if(limitWindowSizeMaxToImageSize){
			interfaceWindow.maxWidth=interfaceImage.spriteWidth+interfaceWindow.borderSizeLeft+interfaceWindow.borderSizeRight;
			interfaceWindow.maxHeight=interfaceImage.spriteHeight+interfaceWindow.borderSizeTop+interfaceWindow.borderSizeBottom;
		}
		guiImage.enabled=true;
		return true;
	}else{
		Log("Failed setting image: "+imageFile);
		Message("Failed setting image: "+imageFile);
		return false;
	}
} 

void DrawGuiImage(){
	guiImage.Draw();
} 

bool GuiImageCatchMouseClick(int click){
	if(!guiImage.enabled){
		return false;
	}
	CritterCl@chosen=GetChosen();
	if((@chosen!=null)){
		
		if(GetCurrentCursor()==(0)&&click==(1)){
			if(interfaceWindow.isWithinDrawArea(__MouseX,__MouseY)){
				
				guiImage.enabled=false;
				return true;
			}else{
				return false;
			}
		}else{
			return interfaceWindow.CatchMouseClick(click);
		}
	}else{
		return false;
	}
} 

bool GuiImageCatchMouseRelease(int click){
	if(!guiImage.enabled){
		return false;
	}
	CritterCl@chosen=GetChosen();
	if((@chosen!=null)){
		
		return interfaceWindow.CatchMouseRelease();
	}else{
		return false;
	}
} 

bool GuiImageUpdateMousePositionChange(int x,int y){
	if(!guiImage.enabled){
		return false;
	}
	
	return interfaceWindow.UpdateMousePositionChange(x,y);
} 

class CGuiImage{
	bool enabled;
	
	CGuiImage(){
		enabled=false;
	}
	
	void Draw(){
		if(!enabled){
			
			return;
		}
		
		if(GUI_GetActiveMainScreen()!=(5)){
			
			return;
		}
		
		CritterCl@chosen=GetChosen();
		if(!(@chosen!=null)){
			
			return;
		}
		interfaceWindow.DrawWindow();
	}
}; 

